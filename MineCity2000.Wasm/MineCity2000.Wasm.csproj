<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
    <EmccInitialHeapSize>268435456</EmccInitialHeapSize>
    <!-- GitHub Pages does not serve pre-compressed .br/.gz twins -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <!-- AOT is slow to build and must not be toggled in an existing obj/ folder (delete obj/ first). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MineCity2000\MineCity2000.csproj" />
  </ItemGroup>

  <!-- All building models in one zip, fetched by the worker on the first conversion. Git-ignored build output. -->
  <ItemGroup>
    <BuildingModelFiles Include="..\buildings\*.mca" />
  </ItemGroup>
  <Target Name="BundleBuildings" BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild" Inputs="@(BuildingModelFiles);$(MSBuildProjectFullPath)" Outputs="wwwroot\buildings.zip">
    <Delete Files="wwwroot\buildings.zip" />
    <ZipDirectory SourceDirectory="..\buildings" DestinationFile="wwwroot\buildings.zip" />
  </Target>

  <!-- The page: esbuild bundles web/ into wwwroot/app.js and wwwroot/converter-client.js. Git-ignored build output. -->
  <ItemGroup>
    <WebSource Include="web\**\*;package.json;package-lock.json;tsconfig.json" />
  </ItemGroup>
  <!-- npm writes node_modules/.package-lock.json, so this also catches a stale node_modules. -->
  <Target Name="NpmCi" Inputs="package-lock.json" Outputs="node_modules\.package-lock.json">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="BuildWebApp" DependsOnTargets="NpmCi" BeforeTargets="ResolveStaticWebAssetsInputs;BeforeBuild"
          Inputs="@(WebSource);$(MSBuildProjectFullPath)" Outputs="wwwroot\app.js;wwwroot\converter-client.js">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <ItemGroup>
    <Watch Include="web\**\*" />
  </ItemGroup>

</Project>
